@model IEnumerable<MvcOdev.Models.Book>

@{
    ViewData["Title"] = "Kitap Listesi";
}

<div class="container mt-4">
    <h2>Kitaplar</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <p>
        <a asp-action="Create" class="btn btn-primary">Yeni Kitap Ekle</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Kitap</th>
                <th>Yazar</th>
                <th>Fiyat</th>
                <th>Stok</th>
                <th>Kategori</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.Price.ToString("C2")</td>
                    <td>@item.Stock</td>
                    <td>@(item.Category != null ? item.Category.Name : "Kategori Yok")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Güncelle</a>

                        <form asp-action="Remove" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu kitabı silmek istediğinize emin misiniz?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Sil</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>