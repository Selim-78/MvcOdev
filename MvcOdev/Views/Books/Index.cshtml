@model IEnumerable<MvcOdev.Models.Book>

<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3">
                <div class="col-md-4">
                    <input type="text" name="searchString" value="@ViewBag.CurrentSearch" class="form-control" placeholder="Kitap adı ile ara..." />
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select" asp-items="ViewBag.Categories">
                        <option value="">Tüm Kategoriler</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="sortOrder" class="form-select">
                        <option value="name_asc" selected="@(ViewBag.CurrentSort == "name_asc")">Kitap Adı (A-Z)</option>
                        <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc")">Kitap Adı (Z-A)</option>
                        <option value="price_asc" selected="@(ViewBag.CurrentSort == "price_asc")">Fiyat (Artan)</option>
                        <option value="price_desc" selected="@(ViewBag.CurrentSort == "price_desc")">Fiyat (Azalan)</option>
                        <option value="stock_asc" selected="@(ViewBag.CurrentSort == "stock_asc")">Stok (Artan)</option>
                        <option value="stock_desc" selected="@(ViewBag.CurrentSort == "stock_desc")">Stok (Azalan)</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary">Filtrele</button>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Kitap Listesi</h2>
        <a asp-action="Create" class="btn btn-success">Yeni Kitap Ekle</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            Aradığınız kriterlere uygun kitap bulunamadı.
        </div>
    }
    else
    {
        <table class="table table-striped table-hover border">
            <thead class="table-dark">
                <tr>
                    <th>Kitap Adı</th>
                    <th>Yazar</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                    <th>Stok</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Author</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Price.ToString("C2")</td>
                        <td>@item.Stock</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Güncelle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>