@model IEnumerable<MvcOdev.Models.Book>

@{
    ViewData["Title"] = "Kitap Listesi";
}

<h2 class="mb-4">Kitap Listesi</h2>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Yeni Kitap Ekle</a>
    </p>
}

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text" name="aramaMetni" value="@ViewBag.CurrentFilter" class="form-control" placeholder="Kitap adı veya yazar ara..." />
    </div>
    <div class="col-md-4">
        <select name="kategoriId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">-- Tüm Kategoriler --</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-secondary">Filtrele</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>Kitap Adı</th>
            <th>Yazar</th>
            <th>
                <a asp-action="Index" asp-route-siralama="@ViewBag.PriceSortParam" asp-route-aramaMetni="@ViewBag.CurrentFilter" asp-route-kategoriId="@ViewBag.CurrentCategory" class="text-white text-decoration-none">
                    Fiyat @(ViewBag.PriceSortParam == "price_desc" ? "🔼" : "🔽")
                </a>
            </th>
            <th>Kategori</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.Price.ToString("C2")</td>
                <td>@item.Category?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">Detay</a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning text-white">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>