@model MvcOdev.Models.Book

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h3 class="card-title mb-0">Kitap Detay Bilgileri</h3>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Kitap Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Kitap Adı</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Yazar Adı</dt>
                <dd class="col-sm-9">@Model.Author</dd>

                <dt class="col-sm-3">Kategori</dt>
                <dd class="col-sm-9">@(Model.Category?.Name ?? "Kategori Belirtilmemiş")</dd>

                <dt class="col-sm-3">Fiyat</dt>
                <dd class="col-sm-9">@Model.Price.ToString("C2")</dd>

                <dt class="col-sm-3">Stok Durumu</dt>
                <dd class="col-sm-9">@Model.Stock adet</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Güncelle</a>
            <a asp-action="Index" class="btn border-secondary">Listeye Geri Dön</a>
        </div>
    </div>
</div>